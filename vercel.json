{
  "rewrites": [
    { "source": "/api/r2-presign", "destination": "/api/create-checkout?__r2=1" },
    { "source": "/join", "destination": "/api/join" },
    { "source": "/qr.png", "destination": "/api/qr" },
    { "source": "/qr", "destination": "/api/qr" },
    {
      "source": "/((?!api/|images/|assets/|favicon\\.svg).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|Applebot).*"
        }
      ],
      "destination": "/api/preview?path=/$1"
    },
    { "source": "/((?!api/|assets/|images/|icons/|favicon\\.svg|manifest\\.webmanifest|sw\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/|images/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/event-reminders", "schedule": "0 8 * * *" }
  ]
}
