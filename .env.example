# Bachs.io Payment Gateway Configuration Template (Server-Side)
BACHS_API_KEY=sk_live_your_live_key_here
BACHS_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Event Confirmation Emails & Inbound Forwarding (Resend - Server-Side)
RESEND_API_KEY=re_your_resend_api_key_here
EVENT_FROM_EMAIL=GAMAT FX Academy <events@gamatfxacademy.com>
FORWARD_TO_EMAIL=your-gmail@gmail.com
ADMIN_NOTIFY_EMAIL=your-gmail@gmail.com

# Cloudflare Edge Media Cache (Client-Side, optional)
VITE_CLOUDFLARE_MEDIA_URL=https://media.gamatfxacademy.com

# Cloudflare R2 Zero-Egress Storage (Server-Side, optional)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=gamatfx-media
R2_PUBLIC_URL=https://cdn.gamatfxacademy.com

# Web Push Notifications (VAPID - Server-Side)
# Single combined variable: VAPID_KEYS=publicKey:privateKey
VAPID_KEYS=your_vapid_public_key:your_vapid_private_key
